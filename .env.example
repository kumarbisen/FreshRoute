# FreshRoute Environment Configuration Template
# Copy this file to .env.local for local development. NEVER commit production secrets.

# -------------------------------------------------------------
# DATABASE PERSISTENCE (PostgreSQL + Prisma)
# -------------------------------------------------------------
DATABASE_URL="postgresql://freshroute_user:freshroute_pass@localhost:5432/freshroute_db?schema=public"

# -------------------------------------------------------------
# CLERK AUTHENTICATION (Server & Client Keys)
# -------------------------------------------------------------
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY="pk_test_placeholder_key"
CLERK_SECRET_KEY="sk_test_placeholder_key"
NEXT_PUBLIC_CLERK_SIGN_IN_URL="/sign-in"
NEXT_PUBLIC_CLERK_SIGN_UP_URL="/sign-up"
NEXT_PUBLIC_CLERK_AFTER_SIGN_IN_URL="/dashboard"
NEXT_PUBLIC_CLERK_AFTER_SIGN_UP_URL="/dashboard"

# -------------------------------------------------------------
# APPLICATION CONFIGURATION
# -------------------------------------------------------------
NEXT_PUBLIC_APP_URL="http://localhost:3000"
NODE_ENV="development"
ENABLE_DEMO_DATA_SEEDING="true"
DEFAULT_SOLVER_ALGORITHM="v1.0.0-fefo-elastic"
