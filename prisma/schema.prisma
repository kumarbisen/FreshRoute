generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// -------------------------------------------------------------
// ENUMS & CLASSIFICATIONS
// -------------------------------------------------------------

enum OrganizationRole {
  OWNER
  DISPATCHER
  PRICING_ANALYST
  LOGISTICS_VIEWER
}

enum QualityGrade {
  GRADE_A // Premium export / display quality
  GRADE_B // Standard retail quality
  GRADE_C // Discount grocery / commercial processing
}

enum UnitOfMeasure {
  KG
  PALLETS
  CASES
}

enum BatchStatus {
  AVAILABLE
  ALLOCATED
  PARTIALLY_ALLOCATED
  EXPIRED
  SALVAGED
}

enum DemandStatus {
  PENDING
  ALLOCATED
  PARTIALLY_ALLOCATED
  DELIVERED
  CANCELLED
}

enum RouteStatus {
  SCHEDULED
  LOADING
  IN_TRANSIT
  COMPLETED
  CANCELLED
}

enum PlanStatus {
  DRAFT
  OPTIMIZED
  COMMITTED
  ARCHIVED
}

enum DiscountStatus {
  PENDING
  APPROVED
  REJECTED
  EXPIRED
}

enum AllocationReasonCode {
  FEFO_URGENCY_PRIORITY
  SHELF_LIFE_SLA_SATISFIED
  DYNAMIC_MARKDOWN_SALVAGE
  COLD_CHAIN_COMPLIANT
  TRANSPORT_CAPACITY_OPTIMIZED
  SECONDARY_BUYER_MATCH
  DISPATCH_WINDOW_ALIGNED
  REJECTED_INSUFFICIENT_SHELF_LIFE
  REJECTED_TEMPERATURE_INCOMPATIBLE
  REJECTED_VEHICLE_OVERFLOW
  REJECTED_MARGIN_FLOOR_VIOLATION
}

// -------------------------------------------------------------
// ORGANIZATION & MULTI-TENANCY
// -------------------------------------------------------------

model Organization {
  id              String                   @id @default(cuid())
  slug            String                   @unique
  name            String
  billingPlan     String                   @default("ENTERPRISE_COLD_CHAIN")
  memberships     OrganizationMembership[]
  warehouses      Warehouse[]
  commodities     Commodity[]
  destinations    Destination[]
  distributionPlans DistributionPlan[]
  scenarios       Scenario[]
  createdAt       DateTime                 @default(now())
  updatedAt       DateTime                 @updatedAt
}

model OrganizationMembership {
  id             String           @id @default(cuid())
  organizationId String
  organization   Organization     @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  userId         String           // Clerk User ID
  role           OrganizationRole @default(DISPATCHER)
  createdAt      DateTime         @default(now())
  updatedAt      DateTime         @updatedAt

  @@unique([organizationId, userId])
  @@index([organizationId])
  @@index([userId])
}

// -------------------------------------------------------------
// WAREHOUSE & COMMODITY
// -------------------------------------------------------------

model Warehouse {
  id               String           @id @default(cuid())
  organizationId   String
  organization     Organization     @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  code             String           @unique
  name             String
  address          String
  city             String
  state            String
  postalCode       String
  latitude         Decimal          @db.Decimal(9, 6)
  longitude        Decimal          @db.Decimal(9, 6)
  totalCapacityKg  Decimal          @db.Decimal(12, 2)
  totalVolumeM3    Decimal          @db.Decimal(10, 2)
  coldStorageType  String           @default("DUAL_ZONE_REFRIGERATED")
  batches          InventoryBatch[]
  routes           Route[]
  createdAt        DateTime         @default(now())
  updatedAt        DateTime         @updatedAt

  @@index([organizationId])
}

model Commodity {
  id                    String              @id @default(cuid())
  organizationId        String
  organization          Organization        @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  code                  String              @unique
  name                  String
  category              String              // "BERRIES", "LEAFY_GREENS", "AVOCADOS", "CITRUS"
  defaultUnit           UnitOfMeasure       @default(KG)
  standardShelfLifeDays Int
  minTempCelsius        Decimal             @db.Decimal(4, 1)
  maxTempCelsius        Decimal             @db.Decimal(4, 1)
  decayRateExponent     Decimal             @default("1.50") @db.Decimal(4, 2)
  defaultPricePerUnit   Decimal             @db.Decimal(10, 2)
  defaultCostPerUnit    Decimal             @db.Decimal(10, 2)
  wasteDisposalCostPerKg Decimal            @db.Decimal(10, 2)
  batches               InventoryBatch[]
  demands               DestinationDemand[]
  createdAt             DateTime            @default(now())
  updatedAt             DateTime            @updatedAt

  @@index([organizationId])
  @@index([category])
}

// -------------------------------------------------------------
// INVENTORY BATCH
// -------------------------------------------------------------

model InventoryBatch {
  id                 String           @id @default(cuid())
  organizationId     String
  warehouseId        String
  warehouse          Warehouse        @relation(fields: [warehouseId], references: [id])
  commodityId        String
  commodity          Commodity        @relation(fields: [commodityId], references: [id])
  batchCode          String           @unique
  harvestDate        DateTime
  receivedDate       DateTime
  expiryDate         DateTime
  initialQuantity    Decimal          @db.Decimal(12, 2)
  availableQuantity  Decimal          @db.Decimal(12, 2)
  reservedQuantity   Decimal          @default("0.00") @db.Decimal(12, 2)
  dispatchedQuantity Decimal          @default("0.00") @db.Decimal(12, 2)
  spoiledQuantity    Decimal          @default("0.00") @db.Decimal(12, 2)
  unitOfMeasure      UnitOfMeasure    @default(KG)
  qualityGrade       QualityGrade     @default(GRADE_A)
  storageTempCelsius Decimal          @db.Decimal(4, 1)
  unitCost           Decimal          @db.Decimal(10, 2)
  basePrice          Decimal          @db.Decimal(10, 2)
  status             BatchStatus      @default(AVAILABLE)
  isDemo             Boolean          @default(false)
  allocations        Allocation[]
  discountRecommendations DiscountRecommendation[]
  quantityAudits     BatchQuantityAudit[]
  createdAt          DateTime         @default(now())
  updatedAt          DateTime         @updatedAt

  @@index([warehouseId])
  @@index([commodityId])
  @@index([expiryDate])
  @@index([status])
}

model BatchQuantityAudit {
  id                 String           @id @default(cuid())
  batchId            String
  batch              InventoryBatch   @relation(fields: [batchId], references: [id], onDelete: Cascade)
  changeType         String           // "INTAKE", "RESERVATION", "DISPATCH", "SPOILAGE", "ADJUSTMENT"
  deltaQuantity      Decimal          @db.Decimal(12, 2)
  resultingAvailable Decimal          @db.Decimal(12, 2)
  resultingReserved  Decimal          @db.Decimal(12, 2)
  reason             String
  createdAt          DateTime         @default(now())

  @@index([batchId])
}

// -------------------------------------------------------------
// DESTINATION & DEMAND
// -------------------------------------------------------------

model Destination {
  id                   String                   @id @default(cuid())
  organizationId       String
  organization         Organization             @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  code                 String                   @unique
  name                 String
  tier                 String                   // "PREMIUM_GROCER", "REGIONAL_SUPERMARKET", "DISCOUNT_CHAIN", "FOOD_SERVICE_PROCESSOR"
  address              String
  city                 String
  state                String
  postalCode           String
  latitude             Decimal                  @db.Decimal(9, 6)
  longitude            Decimal                  @db.Decimal(9, 6)
  minShelfLifeDays     Int                      // Minimum contractual shelf-life remaining on delivery
  acceptsDiscounts     Boolean                  @default(false)
  maxDiscountPercent   Decimal                  @default("0.00") @db.Decimal(5, 2)
  receivingHoursStart  String                   @default("04:00") // 24-hr format
  receivingHoursEnd    String                   @default("14:00")
  isDemo               Boolean                  @default(false)
  demands              DestinationDemand[]
  discountRecommendations DiscountRecommendation[]
  createdAt            DateTime                 @default(now())
  updatedAt            DateTime                 @updatedAt

  @@index([organizationId])
  @@index([tier])
}

model DestinationDemand {
  id                   String        @id @default(cuid())
  organizationId       String
  destinationId        String
  destination          Destination   @relation(fields: [destinationId], references: [id])
  commodityId          String
  commodity            Commodity     @relation(fields: [commodityId], references: [id])
  orderNumber          String        @unique
  requestedQuantity    Decimal       @db.Decimal(12, 2)
  fulfilledQuantity    Decimal       @default("0.00") @db.Decimal(12, 2)
  unitOfMeasure        UnitOfMeasure @default(KG)
  contractedPricePerUnit Decimal     @db.Decimal(10, 2)
  deliveryWindowStart  DateTime
  deliveryWindowEnd    DateTime
  maxReceivingLimitKg  Decimal       @db.Decimal(12, 2)
  status               DemandStatus  @default(PENDING)
  isDemo               Boolean       @default(false)
  allocations          Allocation[]
  createdAt            DateTime      @default(now())
  updatedAt            DateTime      @updatedAt

  @@index([destinationId])
  @@index([commodityId])
  @@index([deliveryWindowStart])
  @@index([status])
}

// -------------------------------------------------------------
// TRANSPORT & FLEET ROUTE
// -------------------------------------------------------------

model Route {
  id                       String        @id @default(cuid())
  organizationId           String
  routeCode                String        @unique
  originWarehouseId        String
  originWarehouse          Warehouse     @relation(fields: [originWarehouseId], references: [id])
  destinationRegion        String
  vehicleType              String        @default("REEFER_HEAVY_TRUCK")
  maxWeightCapacityKg      Decimal       @db.Decimal(12, 2)
  maxVolumeCapacityM3      Decimal       @db.Decimal(10, 2)
  currentAvailableWeightKg Decimal       @db.Decimal(12, 2)
  currentAvailableVolumeM3 Decimal       @db.Decimal(10, 2)
  tempZoneMinCelsius       Decimal       @db.Decimal(4, 1)
  tempZoneMaxCelsius       Decimal       @db.Decimal(4, 1)
  transitDurationHours     Decimal       @db.Decimal(6, 2)
  handlingDurationHours    Decimal       @default("0.50") @db.Decimal(4, 2)
  fixedTripCost            Decimal       @db.Decimal(10, 2) // Flat dispatch fee
  variableCostPerKg        Decimal       @db.Decimal(10, 2) // Fuel & weight cost per kg
  departureTime            DateTime
  estimatedArrivalTime    DateTime
  status                   RouteStatus   @default(SCHEDULED)
  isDemo                   Boolean       @default(false)
  allocations              Allocation[]
  createdAt                DateTime      @default(now())
  updatedAt                DateTime      @updatedAt

  @@index([originWarehouseId])
  @@index([status])
}

// -------------------------------------------------------------
// DISTRIBUTION PLAN & IMMUTABLE SNAPSHOT
// -------------------------------------------------------------

model DistributionPlan {
  id                   String           @id @default(cuid())
  organizationId       String
  organization         Organization     @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  planNumber           String           @unique
  status               PlanStatus       @default(DRAFT)
  algorithmVersion     String           @default("v1.0.0-fefo-elastic")
  snapshotHash         String           // SHA-256 hash of immutable inputs
  planTimestamp        DateTime         @default(now())
  targetDate           DateTime
  totalAllocatedKg     Decimal          @db.Decimal(12, 2)
  unfulfilledDemandKg  Decimal          @db.Decimal(12, 2)
  surplusStockKg       Decimal          @db.Decimal(12, 2)
  totalRevenueUsd      Decimal          @db.Decimal(14, 2)
  totalCostUsd         Decimal          @db.Decimal(14, 2)
  netMarginUsd         Decimal          @db.Decimal(14, 2)
  spoilagePreventedKg  Decimal          @db.Decimal(12, 2)
  spoilagePreventedUsd Decimal          @db.Decimal(14, 2)
  isDemo               Boolean          @default(false)
  snapshot             PlanSnapshot?
  metrics              PlanMetrics?
  allocations          Allocation[]
  createdAt            DateTime         @default(now())
  updatedAt            DateTime         @updatedAt

  @@index([organizationId])
  @@index([status])
  @@index([snapshotHash])
}

model PlanSnapshot {
  id                 String           @id @default(cuid())
  distributionPlanId String           @unique
  distributionPlan   DistributionPlan @relation(fields: [distributionPlanId], references: [id], onDelete: Cascade)
  snapshotJson       String           @db.Text
  hashSha256         String
  createdAt          DateTime         @default(now())
}

// -------------------------------------------------------------
// ALLOCATION LINE ITEMS & REASON CODES
// -------------------------------------------------------------

model Allocation {
  id                   String               @id @default(cuid())
  distributionPlanId   String
  distributionPlan     DistributionPlan     @relation(fields: [distributionPlanId], references: [id], onDelete: Cascade)
  batchId              String
  batch                InventoryBatch       @relation(fields: [batchId], references: [id])
  destinationDemandId  String
  destinationDemand    DestinationDemand    @relation(fields: [destinationDemandId], references: [id])
  routeId              String
  route                Route                @relation(fields: [routeId], references: [id])
  allocatedQuantity    Decimal              @db.Decimal(12, 2)
  unitOfMeasure        UnitOfMeasure        @default(KG)
  discountPercent      Decimal              @default("0.00") @db.Decimal(5, 2)
  effectivePricePerUnit Decimal             @db.Decimal(10, 2)
  grossRevenueUsd      Decimal              @db.Decimal(14, 2)
  transportCostUsd     Decimal              @db.Decimal(14, 2)
  purchaseCostUsd      Decimal              @db.Decimal(14, 2)
  netMarginUsd         Decimal              @db.Decimal(14, 2)
  arrivalShelfLifeDays Decimal              @db.Decimal(6, 2)
  reasonCode           AllocationReasonCode
  reasonExplanation    String
  createdAt            DateTime             @default(now())

  @@index([distributionPlanId])
  @@index([batchId])
  @@index([destinationDemandId])
  @@index([routeId])
}

// -------------------------------------------------------------
// DYNAMIC DISCOUNT RECOMMENDATION
// -------------------------------------------------------------

model DiscountRecommendation {
  id                          String         @id @default(cuid())
  organizationId              String
  batchId                     String
  batch                       InventoryBatch @relation(fields: [batchId], references: [id])
  destinationId               String
  destination                 Destination    @relation(fields: [destinationId], references: [id])
  suggestedDiscountPercent    Decimal        @db.Decimal(5, 2)
  originalPricePerUnit        Decimal        @db.Decimal(10, 2)
  discountedPricePerUnit      Decimal        @db.Decimal(10, 2)
  quantityKg                  Decimal        @db.Decimal(12, 2)
  estimatedDisposalLossAvoided Decimal       @db.Decimal(14, 2)
  projectedGrossMarginUsd     Decimal        @db.Decimal(14, 2)
  status                      DiscountStatus @default(PENDING)
  reasonExplanation           String
  createdAt                   DateTime       @default(now())
  updatedAt                   DateTime       @updatedAt

  @@index([batchId])
  @@index([destinationId])
  @@index([status])
}

// -------------------------------------------------------------
// PLAN METRICS (COMPARATIVE EVALUATION VS FIFO)
// -------------------------------------------------------------

model PlanMetrics {
  id                           String           @id @default(cuid())
  distributionPlanId           String           @unique
  distributionPlan             DistributionPlan @relation(fields: [distributionPlanId], references: [id], onDelete: Cascade)
  baselineProfitUsd            Decimal          @db.Decimal(14, 2)
  proposedProfitUsd            Decimal          @db.Decimal(14, 2)
  profitUpliftUsd              Decimal          @db.Decimal(14, 2)
  profitUpliftPercent          Decimal          @db.Decimal(6, 2)
  baselineSpoilageKg           Decimal          @db.Decimal(12, 2)
  proposedSpoilageKg           Decimal          @db.Decimal(12, 2)
  spoilageReductionKg          Decimal          @db.Decimal(12, 2)
  spoilageReductionPercent     Decimal          @db.Decimal(6, 2)
  baselineSlaCompliancePercent Decimal          @db.Decimal(5, 2)
  proposedSlaCompliancePercent Decimal          @db.Decimal(5, 2)
  baselineRejectionsCount      Int              @default(0)
  proposedRejectionsCount      Int              @default(0)
  createdAt                    DateTime         @default(now())
}

// -------------------------------------------------------------
// WHAT-IF SCENARIO SANDBOX
// -------------------------------------------------------------

model Scenario {
  id                         String       @id @default(cuid())
  organizationId             String
  organization               Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  name                       String
  description                String
  basePlanId                 String?
  transitDelayHours          Decimal      @default("0.00") @db.Decimal(5, 2)
  temperatureDeltaCelsius    Decimal      @default("0.00") @db.Decimal(4, 2)
  demandMultiplierPercent    Decimal      @default("100.00") @db.Decimal(5, 2)
  fuelCostMultiplierPercent  Decimal      @default("100.00") @db.Decimal(5, 2)
  simulatedProfitDeltaUsd    Decimal?     @db.Decimal(14, 2)
  simulatedSpoilageDeltaKg   Decimal?     @db.Decimal(12, 2)
  status                     String       @default("DRAFT") // "DRAFT", "EVALUATED", "ARCHIVED"
  createdAt                  DateTime     @default(now())
  updatedAt                  DateTime     @updatedAt

  @@index([organizationId])
}
